{
  "name": "nox-map-engine-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev:examples": "vp dev --config examples/vite.config.ts --host 127.0.0.1",
    "dev": "vp dev --config apps/standalone/vite.config.ts --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config tests/production/playwright.config.ts",
    "verify:packages": "node scripts/verify-packages.mjs",
    "benchmark": "playwright test --config benchmarks/playwright.config.ts",
    "prepare-map": "vpx packages/cli/src/bin.ts",
    "fixtures": "vpx scripts/fixtures.ts",
    "release": "node scripts/release.mjs",
    "test:ci-policy": "node --test scripts/ci-policy.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-hooks.mjs')) await import('./scripts/install-hooks.mjs');\"",
    "precommit": "node scripts/git-hooks.mjs commit",
    "check": "node scripts/git-hooks.mjs check",
    "prepush": "node scripts/format-files.mjs --check --revision HEAD && npm run check",
    "test:release": "node --test scripts/release.test.mjs scripts/ci-policy.test.mjs",
    "check:code": "vp check",
    "format:check": "node scripts/format-files.mjs --check",
    "format": "node scripts/format-files.mjs",
    "test:format": "node --test scripts/format-files.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@prettier/plugin-xml": "3.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "prettier-plugin-sh": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  }
}
